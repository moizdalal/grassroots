PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Browser sign-in + marketplace (anon / publishable key from Supabase dashboard)
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Stripe Connect (test keys for sandbox; live keys for production)
STRIPE_SECRET_KEY=sk_test_…
STRIPE_PUBLISHABLE_KEY=pk_test_…
# Webhook signing secret — get this from Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret.
# For local dev, run `stripe listen --forward-to localhost:3000/webhooks/stripe` and copy the whsec_ value it prints.
STRIPE_WEBHOOK_SECRET=whsec_…

# Public origin used when an invite link is created through the admin API.
APP_URL=http://localhost:3000
# Shared secret for POST /api/admin/consultant-invites. Server only.
CONSULTANT_INVITE_SECRET=

# Transactional email (Resend). Unset key → emails are logged, not sent.
RESEND_API_KEY=re_…
RESEND_FROM_EMAIL=Grassroots <notifications@grassroots-marketplace.com>
RESEND_REPLY_TO=moiz+support@grassroots-marketplace.com
# Outside Vercel production every email goes here instead of the real
# recipient. Without it, local and preview runs send nothing.
EMAIL_REDIRECT_TO=
# Resend plan caps for the admin Emails tab. Defaults match the free plan
# (100 a day, 3,000 a month). Raise them after upgrading.
RESEND_DAILY_LIMIT=
RESEND_MONTHLY_LIMIT=
